# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=

# Admin User IDs (comma-separated for multiple admins)
ADMIN_IDS=123456789,987654321

# Channel ID where confessions will be posted
CHANNEL_ID=-1001234567890

# Admin Group ID for moderation
ADMIN_GROUP_ID=-1001234567890

# MongoDB Connection String (use MongoDB Atlas or other managed MongoDB)
MONGODB_URI=mongodb+srv://username:password@cluster0.example.mongodb.net/confession_bot?retryWrites=true&w=majority

# Optional: if deploying as a Web Service (not needed for Render Background Worker)
KEEP_ALIVE_PORT=
